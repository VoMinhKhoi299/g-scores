erDiagram
    subjects {
        varchar code PK "khớp code của enum Subject"
        varchar name "tên tiếng Việt"
    }

    subject_groups {
        varchar group_code PK "A, B, C"
        varchar name "tên hiển thị"
    }

    group_subjects {
        varchar group_code PK "FK -> subject_groups"
        varchar subject_code PK "FK -> subjects"
    }

    students {
        varchar sbd PK "8 chữ số, CHECK regex"
        varchar ma_ngoai_ngu "N1..N7 hoặc NULL"
    }

    student_scores {
        varchar sbd PK "FK -> students, CASCADE"
        varchar subject_code PK "FK -> subjects"
        numeric score "NOT NULL, CHECK 0..10"
    }

    score_distribution {
        varchar subject_code PK "FK -> subjects"
        varchar band PK "VERY_GOOD/GOOD/FAIR/POOR"
        bigint student_count "số thí sinh thuộc mức"
        numeric percentage "tỷ lệ % trên số người thi môn"
    }

    group_top_students {
        varchar group_code PK "FK -> subject_groups"
        int rank PK "1..10"
        varchar sbd FK "ON DELETE CASCADE, UNIQUE (group_code, sbd)"
        numeric total "tổng điểm các môn của nhóm"
        numeric avg_score "total chia số môn"
    }

    dataset_metadata {
        smallint id PK "CHECK id = 1 (luôn 1 dòng)"
        varchar source_file "tên file CSV nguồn"
        bigint total_rows "1061605"
        timestamptz seeded_at
    }

    subject_groups ||--o{ group_subjects : "1 nhóm có nhiều môn"
    subjects ||--o{ group_subjects : "1 môn thuộc nhiều nhóm"
    students ||--o{ student_scores : "1 HS có điểm nhiều môn"
    subjects ||--o{ student_scores : "1 môn có nhiều điểm"
    subjects ||--o{ score_distribution : "1 môn có 4 mức điểm"
    subject_groups ||--o{ group_top_students : "1 nhóm có top 10"
    students ||--o{ group_top_students : "1 HS vào top nhiều nhất 1 lần"
