classDiagram
    direction LR

    class Subject {
        <<enumeration>>
        +String code
        +String name
        +getCode() String
        +getName() String
    }

    class SubjectGroup {
        <<record>>
        +String code
        +String name
        +List~Subject~ subjects
        +standard() List~SubjectGroup~
    }

    class ScoreBand {
        <<enumeration>>
        VERY_GOOD
        GOOD
        FAIR
        POOR
        +BigDecimal minScore
        +of(BigDecimal) ScoreBand
    }

    class ForeignLanguage {
        <<enumeration>>
        N1
        N2
        N3
        N4
        N5
        N6
        N7
    }

    class Student {
        <<entity>> students
        +String sbd PK
        +ForeignLanguage foreignLanguageCode
    }

    class StudentScore {
        <<entity>> student_scores
        +String sbd PK
        +String subjectCode PK
        +BigDecimal score
    }

    class SubjectEntity {
        <<entity>> subjects
        +String code PK
        +String name
    }

    class SubjectGroupEntity {
        <<entity>> subject_groups
        +String groupCode PK
        +String name
    }

    class GroupSubjectEntity {
        <<entity>> group_subjects
        +String groupCode PK
        +String subjectCode PK
    }

    class ScoreDistribution {
        <<entity>> score_distribution
        +String subjectCode PK
        +String band PK
        +long studentCount
        +BigDecimal percentage
    }

    class GroupTopStudent {
        <<entity>> group_top_students
        +String groupCode PK
        +int rank PK
        +String sbd
        +BigDecimal total
        +BigDecimal avgScore
    }

    class DatasetMetadata {
        <<entity>> dataset_metadata
        +int id PK
        +String sourceFile
        +long totalRows
        +OffsetDateTime seededAt
    }

    class StudentRepository {
        <<interface>>
        +findById(String) Optional~Student~
    }

    class StudentScoreRepository {
        <<interface>>
        +findBySbd(String) List~StudentScore~
        +findScoresBySbd(String) List~Object[]~
    }

    class SubjectRepository {
        <<interface>>
        +findAll() List~SubjectEntity~
    }

    class SubjectGroupRepository {
        <<interface>>
        +findAll() List~SubjectGroupEntity~
    }

    class GroupSubjectRepository {
        <<interface>>
        +findByGroupCode(String) List~GroupSubjectEntity~
    }

    class ScoreDistributionRepository {
        <<interface>>
        +findAll() List~ScoreDistribution~
    }

    class GroupTopStudentRepository {
        <<interface>>
        +findByGroupCodeOrderByRank(String) List~GroupTopStudent~
    }

    class DatasetMetadataRepository {
        <<interface>>
        +findById(Integer) Optional~DatasetMetadata~
    }

    SubjectGroup --> Subject : subjects
    StudentScore --> Subject : subjectCode
    GroupSubjectEntity --> SubjectGroupEntity : groupCode
    GroupSubjectEntity --> SubjectEntity : subjectCode
    ScoreDistribution --> SubjectEntity : subjectCode
    GroupTopStudent --> SubjectGroupEntity : groupCode
    Student --> ForeignLanguage : foreignLanguageCode

    StudentRepository --> Student : manages
    StudentScoreRepository --> StudentScore : manages
    SubjectRepository --> SubjectEntity : manages
    SubjectGroupRepository --> SubjectGroupEntity : manages
    GroupSubjectRepository --> GroupSubjectEntity : manages
    ScoreDistributionRepository --> ScoreDistribution : manages
    GroupTopStudentRepository --> GroupTopStudent : manages
    DatasetMetadataRepository --> DatasetMetadata : manages
